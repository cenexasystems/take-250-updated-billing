{
  "name": "yg-enterprises-pos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "generate:icons": "node scripts/generate-app-icons.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed-passcodes.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:reset-dev": "tsx scripts/db-reset-dev.ts",
    "test:isolation": "tsx scripts/test-isolation.ts",
    "test:api": "tsx scripts/test-api.ts --part=1 && tsx scripts/test-api.ts --part=2 && tsx scripts/test-api.ts --part=3 --branch=pos1 && tsx scripts/test-api.ts --part=3 --branch=pos2 && tsx scripts/test-api.ts --part=3 --branch=pos3 && tsx scripts/test-api.ts --part=4",
    "test:e2e": "tsx scripts/e2e.ts",
    "dev:full": "npm run build && tsx scripts/dev-server.ts",
    "typecheck:server": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "@zxing/browser": "^0.2.1",
    "autoprefixer": "^10.4.27",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "framer-motion": "^12.38.0",
    "html2canvas": "^1.4.1",
    "jsbarcode": "^3.12.3",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.7.0",
    "pg": "^8.23.1",
    "postcss": "^8.5.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-parallax-tilt": "^1.7.260",
    "react-router-dom": "^7.13.2",
    "recharts": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "zod": "^3.25.76",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/express": "^5.0.6",
    "@types/jsbarcode": "^3.11.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.12.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "playwright": "^1.60.0",
    "sharp": "^0.35.4",
    "ts-node": "^10.9.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "ts-node": {
    "esm": true,
    "experimentalEsm": true,
    "compilerOptions": {
      "module": "esnext"
    }
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
