# ---- Server only (never prefix with VITE_; these must not reach the browser) ----
# Neon Postgres connection string. Use the POOLED endpoint (host contains "-pooler") in production and on Vercel.
# (The tests automatically use the direct endpoint instead: see scripts/test-env.ts. It is for tests only.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Neon DIRECT (non-pooled) string: used by 
pm run db:migrate, db:seed and the tests when set; the app never needs it.
# Set it in Vercel too if you run migrations from there; otherwise keep it only in your local .env.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require
# Long random string used to sign session JWTs, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
# Vercel Blob read/write token (Vercel dashboard > Storage > Blob; added automatically when the store is connected)
BLOB_READ_WRITE_TOKEN=

# Initial passcodes (min 8 chars, all unique). Read once by `npm run db:seed`, stored bcrypt-hashed.
# After seeding, change them from Admin > Change passcodes and remove them from the environment.
SEED_PASSCODE_ADMIN=
SEED_PASSCODE_STAFF_BRANCH1=
SEED_PASSCODE_STAFF_BRANCH2=
SEED_PASSCODE_STAFF_BRANCH3=
SEED_PASSCODE_MANAGER_BRANCH1=
SEED_PASSCODE_MANAGER_BRANCH2=
SEED_PASSCODE_MANAGER_BRANCH3=

# Optional: login slowdown once the whole system has seen 10+ failed logins in 15 min
# (milliseconds added per extra failure, and the cap). Defaults shown.
# LOGIN_SLOWDOWN_STEP_MS=200
# LOGIN_SLOWDOWN_MAX_MS=4000

# No browser-side (VITE_) variables are needed: shop phone numbers, address and Instagram are Store Settings data.

# ---- Tests (npm run test:api / test:isolation / test:e2e) ----
# A SEPARATE Neon branch used only by tests and e2e. The scripts refuse to run when it is the same database as
# DATABASE_URL, DATABASE_URL_UNPOOLED, PREVIEW_DATABASE_URL or PRODUCTION_DATABASE_URL.
TEST_DATABASE_URL=
# Optional: the Vercel preview / production strings, only so the guard can recognise them.
# PREVIEW_DATABASE_URL=
# PRODUCTION_DATABASE_URL=
